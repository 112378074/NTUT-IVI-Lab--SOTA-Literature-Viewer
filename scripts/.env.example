# Email notification config
# Copy this file to ".env" (no extension) in the same folder, then fill in.
# .env is gitignored — credentials never get committed.
#
# === Gmail App Password setup ===
# 1. Enable 2-Step Verification on the Gmail account:
#    https://myaccount.google.com/security
# 2. Open https://myaccount.google.com/apppasswords
#    (only available after 2FA is on)
# 3. Generate an App password for "Mail" / "Windows Computer"
# 4. Copy the 16-char password (no spaces) into SMTP_PASSWORD below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=azaz31855@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_TO=azaz31855@gmail.com
